<UserControl x:Class="DiscRippa.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DiscRippa.ViewModels.Shared;assembly=DiscRippa.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QueueViewModel}">
    <!-- The Compress Queue tab. Files can be dropped anywhere on it. -->
    <Grid AllowDrop="True" Background="Transparent" DragOver="Area_DragOver" Drop="Area_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Banner}" Margin="0,0,0,12"
                Visibility="{Binding HandBrakeFound, Converter={StaticResource NotBoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Locate HandBrakeCLI…" Margin="12,0,0,0" Command="{Binding LocateHandBrakeCommand}"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"
                           Text="HandBrakeCLI wasn't found, so compression is off. It's included in the tools folder. Or download the &quot;Command Line Version&quot; from handbrake.fr, then click Locate HandBrakeCLI…"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="Add files…" Command="{Binding AddFilesCommand}" IsEnabled="{Binding HandBrakeFound}"/>
            <TextBlock DockPanel.Dock="Left" Text="Quality" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox DockPanel.Dock="Left" Width="300" MaxDropDownHeight="420"
                      ItemsSource="{Binding PresetChoices}" SelectedItem="{Binding Preset, Mode=TwoWay}"/>
            <TextBlock DockPanel.Dock="Left" Text="Save as" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox DockPanel.Dock="Left" Width="190" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}">
                <ComboBoxItem Content="MP4 (plays everywhere)"/>
                <ComboBoxItem Content="MKV (all tracks)"/>
            </ComboBox>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SubtleText}" VerticalAlignment="Center"
                       Text="Tip: drag video files here"/>
        </DockPanel>

        <DataGrid x:Name="JobsGrid" Grid.Row="2" Style="{StaticResource ListGrid}" SelectionMode="Extended"
                  ItemsSource="{Binding Jobs}" SelectionChanged="JobsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.4*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110"/>
                <DataGridTemplateColumn Header="Progress" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <ProgressBar Height="5" Value="{Binding ProgressValue, Mode=OneWay}"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource SubtleBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Quality" Binding="{Binding QualityText}" Width="1.3*"/>
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding Queue.CurrentText}" FontWeight="SemiBold"/>
            <ProgressBar Margin="0,8,0,0" Value="{Binding Queue.CurrentPercent, Mode=OneWay}"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Style="{StaticResource SubtleText}" Margin="2,10,0,0"
                   Text="{Binding ElementName=JobsGrid, Path=SelectedItem.Detail}"/>

        <WrapPanel Grid.Row="5" Margin="0,12,0,0">
            <Button Content="Stop current" Command="{Binding StopCurrentCommand}" IsEnabled="{Binding HandBrakeFound}"/>
            <Button Content="{Binding PauseText}" Margin="8,0,0,0" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding HandBrakeFound}"/>
            <Button Content="Cancel selected" Margin="8,0,0,0" Command="{Binding CancelSelectedCommand}"/>
            <Button Content="Retry selected" Margin="8,0,0,0" Command="{Binding RetrySelectedCommand}"/>
            <Button Content="Remove selected" Margin="8,0,0,0" Command="{Binding RemoveSelectedCommand}"/>
            <Button Content="Clear finished" Margin="8,0,0,0" Command="{Binding ClearFinishedCommand}"/>
        </WrapPanel>
    </Grid>
</UserControl>
