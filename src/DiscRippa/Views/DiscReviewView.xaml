<UserControl x:Class="DiscRippa.Views.DiscReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DiscRippa.Views"
             xmlns:vm="clr-namespace:DiscRippa.ViewModels.Video;assembly=DiscRippa.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiscReviewViewModel}">
    <!-- The disc screen: what is on the disc, what to rip, where to, and the RIP button. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Margin="2,0,0,14">
            <TextBlock Text="{Binding DiscTitle}" Style="{StaticResource Heading}" FontSize="24"/>
            <TextBlock Text="{Binding DiscSummary}" Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>

            <Border Style="{StaticResource AutomationBannerStyle}" Margin="0,12,0,0"
                    Visibility="{Binding IsAutomated, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Let me choose" Margin="16,0,0,0" Command="{Binding TakeOverCommand}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutomationText}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"/>
                        <ProgressBar Height="6" Margin="0,8,0,0" Value="{Binding AutomationProgress, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12.5" Margin="0,6,0,0"
                                   Text="These settings are locked while automation mode runs. Click Let me choose to pick them yourself for this disc."/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- left: titles and tracks -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Titles on this disc" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsEditable}">
                        <Button Style="{StaticResource LinkButton}" Content="Main movie only" Command="{Binding SelectMainOnlyCommand}"/>
                        <TextBlock Text="   ·   " Foreground="{DynamicResource SubtleBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Every title over 2 min" Command="{Binding SelectAllLongCommand}"/>
                        <TextBlock Text="   ·   " Foreground="{DynamicResource SubtleBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="None" Command="{Binding SelectNoneCommand}"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" Style="{StaticResource ListGrid}" SelectionMode="Single"
                          ItemsSource="{Binding Titles}" SelectedItem="{Binding SelectedTitle, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Rip" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="38"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                        <DataGridTextColumn Header="Length" Binding="{Binding Duration}" Width="78"/>
                        <DataGridTextColumn Header="Chapters" Binding="{Binding Chapters}" Width="74"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="78"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="{Binding StreamsHeader}" Style="{StaticResource Label}" Margin="0,14,0,8"/>

                <DataGrid Grid.Row="3" Style="{StaticResource ListGrid}" SelectionMode="Single" RowHeight="32"
                          ItemsSource="{Binding SelectedTitle.Streams}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Codec}" Width="1.2*"/>
                        <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="100"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="1.3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- right: rip details -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18" IsEnabled="{Binding IsEditable}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Rip details" Style="{StaticResource Heading}" FontSize="18" Margin="0,0,0,14"/>

                        <!-- The output path is a setting; "Change…" opens Settings right at it. -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Change…" VerticalAlignment="Bottom"
                                    Margin="10,0,0,0" Command="{Binding ChangeFolderCommand}" ToolTip="Change the output path in Settings"/>
                            <TextBlock Text="Output path" Style="{StaticResource Label}" Margin="0"/>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="📁" FontFamily="Segoe UI Emoji" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Folder}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SpaceText}" FontSize="12.5" Margin="2,5,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SpaceIsLow}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding NameLabel}" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding NameHint}" Style="{StaticResource SubtleText}" FontSize="12.5" Margin="2,5,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsMultiple, Converter={StaticResource BoolToVis}}"/>

                        <Border Background="{DynamicResource LineBrush}" Height="1" Margin="0,16,0,14"/>

                        <TextBlock Text="What will be ripped" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap"/>

                        <TextBlock Text="Files that will be created" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                        <TextBlock Text="{Binding FilesText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5"/>

                        <TextBlock Text="Format" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                        <TextBlock Text="{Binding FormatText}" Style="{StaticResource SubtleText}"/>

                        <Border Background="{DynamicResource LineBrush}" Height="1" Margin="0,16,0,14"/>

                        <CheckBox IsChecked="{Binding Compress, Mode=TwoWay}" IsEnabled="{Binding CanCompress}">
                            <TextBlock Text="Also make a smaller copy with HandBrake" TextWrapping="Wrap"/>
                        </CheckBox>
                        <ComboBox Margin="28,8,0,0" ItemsSource="{Binding PresetChoices}" MaxDropDownHeight="380"
                                  SelectedItem="{Binding Preset, Mode=TwoWay}" IsEnabled="{Binding Compress}"/>
                        <StackPanel Margin="28,10,0,0" IsEnabled="{Binding CanKeepOriginal}">
                            <RadioButton GroupName="CopyFormat" IsChecked="{Binding SaveAsMp4, Mode=TwoWay}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="MP4"/>
                                    <Run Text="– plays on everything (iPhone, Apple TV, browsers). Main soundtrack as stereo + 5.1."/>
                                </TextBlock>
                            </RadioButton>
                            <RadioButton GroupName="CopyFormat" Margin="0,6,0,0" IsChecked="{Binding SaveAsMkv, Mode=TwoWay}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="MKV"/>
                                    <Run Text="– keeps every audio track (TrueHD, DTS-HD, Atmos) and subtitle exactly. For Plex, VLC, Kodi, Infuse."/>
                                </TextBlock>
                            </RadioButton>
                        </StackPanel>
                        <CheckBox Margin="28,10,0,0" IsChecked="{Binding KeepOriginal, Mode=TwoWay}" IsEnabled="{Binding CanKeepOriginal}">
                            <TextBlock Text="Keep the MKV too (otherwise it's deleted once the smaller copy is done)" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Eject, Mode=TwoWay}" Margin="0,12,0,0" Content="Eject the disc when finished"
                                  IsEnabled="{Binding CanChangeEject}"/>

                        <TextBlock Text="{Binding AfterText}" Style="{StaticResource SubtleText}" FontSize="12.5" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- bottom bar -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Cancel" MinWidth="110" Padding="16,10" Command="{Binding CancelCommand}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="RIP"
                    MinWidth="220" Height="54" FontSize="20" Command="{Binding RipCommand}"
                    IsEnabled="{Binding CanRip}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" Margin="0,0,18,0" TextWrapping="NoWrap"/>
        </DockPanel>
    </Grid>
</UserControl>
