<UserControl x:Class="DiscRippa.Views.CdReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DiscRippa.Views"
             xmlns:vm="clr-namespace:DiscRippa.ViewModels.Music;assembly=DiscRippa.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CdReviewViewModel}">
    <!-- The CD screen: album details, tracks (renameable), where the files go, and the RIP button. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,14">
            <TextBlock Text="{Binding Album}" Style="{StaticResource Heading}" FontSize="24" TextTrimming="CharacterEllipsis"/>
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0">
                <Run Text="{Binding Artist, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <Run Text="   "/>
                <Run Text="{Binding DiscSummary, Mode=OneWay}"/>
                <Run Text="   "/>
                <Run Text="{Binding DiscOfText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding LookupText}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FoundNames}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Style="{StaticResource AutomationBannerStyle}" Margin="0,12,0,0"
                    Visibility="{Binding IsAutomated, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Let me choose" Margin="16,0,0,0" Command="{Binding TakeOverCommand}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutomationText}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"/>
                        <ProgressBar Height="6" Margin="0,8,0,0" Value="{Binding AutomationProgress, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource SubtleText}" FontSize="12.5" Margin="0,6,0,0"
                                   Text="These settings are locked while automation mode runs. Click Let me choose to pick them yourself for this CD."/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Tracks (click a title to rename it)" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsEditable}">
                        <Button Style="{StaticResource LinkButton}" Content="All" Command="{Binding SelectAllCommand}"/>
                        <TextBlock Text="   ·   " Foreground="{DynamicResource SubtleBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="None" Command="{Binding SelectNoneCommand}"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" Style="{StaticResource ListGrid}" SelectionMode="Single" ItemsSource="{Binding Tracks}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Rip" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding NumberText}" Width="42"/>
                        <DataGridTemplateColumn Header="Title" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                             BorderThickness="0" Background="Transparent" Padding="2,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Length" Binding="{Binding Duration}" Width="74"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18" IsEnabled="{Binding IsEditable}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Rip details" Style="{StaticResource Heading}" FontSize="18" Margin="0,0,0,14"/>

                        <TextBlock Text="Artist" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Album" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Year" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Music folder" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MusicRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseMusicFolderCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding AlbumFolder}" Style="{StaticResource SubtleText}" FontSize="12.5" Margin="2,5,0,0" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource LineBrush}" Height="1" Margin="0,16,0,14"/>

                        <TextBlock Text="What will be ripped" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap"/>

                        <TextBlock Text="Files that will be created" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                        <TextBlock Text="{Binding FilesText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12.5"/>

                        <TextBlock Text="Format" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                        <TextBlock Text="{Binding FormatText}" Style="{StaticResource SubtleText}"/>

                        <Border Background="{DynamicResource LineBrush}" Height="1" Margin="0,16,0,14"/>

                        <CheckBox IsChecked="{Binding Eject, Mode=TwoWay}" Content="Eject the CD when finished"
                                  IsEnabled="{Binding CanChangeEject}"/>
                        <TextBlock Text="{Binding AfterText}" Style="{StaticResource SubtleText}" FontSize="12.5" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Cancel" MinWidth="110" Padding="16,10" Command="{Binding CancelCommand}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="RIP"
                    MinWidth="220" Height="54" FontSize="20" Command="{Binding RipCommand}"
                    IsEnabled="{Binding CanRip}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" Margin="0,0,18,0" TextWrapping="NoWrap"/>
        </DockPanel>
    </Grid>
</UserControl>
