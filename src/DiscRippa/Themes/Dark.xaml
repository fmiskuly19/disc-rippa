<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: warm near-black, borderless rounded cards, bright green progress. Fills keep the #37892B accent (the grass in the logo). -->

    <!-- Colours -->
    <SolidColorBrush x:Key="BgBrush" Color="#1B1919"/>
    <SolidColorBrush x:Key="CardBrush" Color="#262222"/>
    <SolidColorBrush x:Key="TileBrush" Color="#1F1C1C"/>
    <SolidColorBrush x:Key="InputBrush" Color="#2C2828"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#322E2E"/>
    <SolidColorBrush x:Key="ButtonLineBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F0F0"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#A39D9D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3A3535"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#3B3636"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#444040"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#37892B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#42A033"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2E7524"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1C3318"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#6CC24A"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7FD35A"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ProgressBrush" Color="#6CC24A"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#1C3318"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2E1A1A"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="#6B2A2A"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#322E2E"/>
    <SolidColorBrush x:Key="AltRowBrush" Color="#292525"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#22401D"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FDBA74"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#2E2219"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#7C4A1C"/>

    <!-- Shapes -->
    <CornerRadius x:Key="CardRadius">22</CornerRadius>
    <CornerRadius x:Key="PanelRadius">16</CornerRadius>
    <CornerRadius x:Key="ControlRadius">14</CornerRadius>
    <CornerRadius x:Key="BarRadius">8</CornerRadius>
    <Thickness x:Key="CardBorderThickness">0</Thickness>

</ResourceDictionary>
