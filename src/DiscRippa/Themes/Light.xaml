<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Accent #37892B (the grass in the logo). -->

    <!-- Colours -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonLineBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#37892B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2E7524"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#24601C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF5E6"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#B3DAA8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2E7524"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ProgressBrush" Color="#37892B"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="AltRowBrush" Color="#FAFAFB"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#D8EED2"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#9A3412"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFF7ED"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#FDBA74"/>

    <!-- Shapes -->
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="PanelRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="BarRadius">4</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1</Thickness>

</ResourceDictionary>
